# Server-only Google integration settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: explicitly override redirect URI (defaults to dynamic host/Vercel URL or http://localhost:4000/api/auth/callback/google)
GOOGLE_REDIRECT_URI=
GOOGLE_SHEETS_ID=
SHEETS_SCHEDULE_URL=
SHEETS_WRITE_URL=
SHEETS_DIARY_URL=
# Optional shared-secret header expected by the write proxy (never exposed to the browser)
SHEETS_WRITE_TOKEN=

# Optional session encryption secret (defaults to hashing GOOGLE_CLIENT_SECRET if omitted)
AUTH_SECRET=

# Optional automation and AI provider settings
N8N_WEBHOOK_URL=
AI_API_KEY=
AI_API_BASE_URL=

# Groq AI provider (assistant + AI features) — model is configured here, not in code
GROQ_API_KEY=
GROQ_MODEL=
# Optional override of the Groq chat completions endpoint
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Database Clone Mode (PostgreSQL - bypasses Google Sheets & OAuth when set)
DATABASE_URL=
AUTH_DISABLED=

# Throwaway local PostgreSQL used only by DB integration tests (never point at a real database)
TEST_DATABASE_URL=

# Agent API (OpenClaw), database mode only. See docs/adr/0007-agent-api-and-approval-boundary.md
# Required for the owner/admin routes: comma-separated owner emails (fail-closed when empty)
AGENT_ADMIN_EMAILS=
# Optional limits (defaults shown)
# AGENT_RATE_LIMIT_READS_PER_MIN=60
# AGENT_RATE_LIMIT_PROPOSALS_PER_MIN=10
# AGENT_MAX_PENDING_PROPOSALS=20
# AGENT_PROPOSAL_TTL_HOURS=24
# AGENT_TOKEN_DEFAULT_TTL_DAYS=90
